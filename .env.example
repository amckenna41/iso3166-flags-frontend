# ISO 3166 Flags Explorer — Environment Variables
#
# Copy this file to .env and fill in the values you want to override.
# All variables are optional; the defaults in src/config/appConfig.ts are
# used when a variable is absent.

# ISO 3166-2 API base URL
# REACT_APP_ISO3166_2_API=https://iso3166-2-api.vercel.app/api

# REST Countries API key (v5) — used server-side only via api/country-info.js.
# Never use REACT_APP_ prefix here; that would bundle the key into the browser.
# For local dev: set in .env.local (gitignored).
# For Vercel: add REST_COUNTRIES_API_KEY in the project's Environment Variables settings.
# REST_COUNTRIES_API_KEY=your_key_here

# Raw GitHub URL for the ISO 3166 flags repository
# REACT_APP_FLAGS_REPOSITORY=https://raw.githubusercontent.com/amckenna41/iso3166-flags/main
